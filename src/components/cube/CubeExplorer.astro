---
// Interactive 3×3 cube explorer built with cubing.js.
// The cube rendering and all interaction logic live in the client-side
// script block below, so this component has no frontmatter logic.
---

<div class="cube-explorer">
	<form id="reset-form" class="controls">
		<label class="sr-only" for="reset-input">Reset state mutation</label>
		<input
			id="reset-input"
			type="text"
			placeholder="Reset to: solved + mutation (e.g. R U R' U'; blank = solved)"
			autocomplete="off"
			spellcheck="false"
		/>
		<button id="reset-btn" class="btn" type="submit">Reset</button>
	</form>

	<div class="player-container">
		<div id="player-host"></div>
	</div>

	<div class="controls view-controls">
		<button
			id="cross-toggle-btn"
			class="btn toggle"
			type="button"
			aria-pressed="false"
		>
			Cross only
		</button>

		<label class="speed-control" for="speed-slider">
			<span class="speed-label">Animation speed</span>
			<input
				id="speed-slider"
				type="range"
				min="0.1"
				max="2"
				step="0.05"
				value="0.25"
			/>
			<output id="speed-value" class="speed-value" for="speed-slider"
				>0.25×</output
			>
		</label>
	</div>

	<form id="mutation-form" class="controls">
		<label class="sr-only" for="mutation-input">Mutation</label>
		<input
			id="mutation-input"
			type="text"
			placeholder="Enter a mutation, e.g. R U R' U'"
			autocomplete="off"
			spellcheck="false"
		/>
		<button id="run-btn" class="btn primary" type="submit">Run</button>
	</form>

	<p id="message" class="message" role="status" aria-live="polite"></p>

	<p class="hint">
		Use standard cube notation: <code>R U R' U'</code>, <code>F2</code>,
		<code>M</code>, <code>Rw</code>, … The field above sets the state you can
		<strong>Reset</strong> to: the solved cube, then that mutation (blank
		means a solved cube). The field below applies moves on top with
		<strong>Run</strong>. Use <strong>Cross only</strong> to highlight just
		the CFOP cross pieces, and the slider to adjust the animation speed
		(default is deliberately slow).
	</p>
</div>

<script>
	import { Alg } from "cubing/alg";
	import { TwistyPlayer } from "cubing/twisty";

	const playerHost = document.getElementById("player-host");
	const resetForm = document.getElementById("reset-form");
	const resetInput = document.getElementById("reset-input");
	const resetBtn = document.getElementById("reset-btn");
	const form = document.getElementById("mutation-form");
	const input = document.getElementById("mutation-input");
	const runBtn = document.getElementById("run-btn");
	const crossToggleBtn = document.getElementById("cross-toggle-btn");
	const speedSlider = document.getElementById("speed-slider");
	const speedValue = document.getElementById("speed-value");
	const message = document.getElementById("message");

	if (
		playerHost &&
		resetForm &&
		resetInput &&
		resetBtn &&
		form &&
		input &&
		runBtn &&
		crossToggleBtn &&
		speedSlider &&
		speedValue &&
		message
	) {
		const player = new TwistyPlayer({
			puzzle: "3x3x3",
			alg: "",
			background: "none",
			visualization: "Cube3D",
		});
		playerHost.appendChild(player);

		let moveCount = 0;

		function setMessage(text, kind = "info") {
			message.textContent = text;
			message.dataset.kind = kind;
		}

		function runMutation() {
			const raw = input.value.trim();
			if (!raw) {
				setMessage("Please enter a mutation first.", "error");
				input.focus();
				return;
			}

			let alg;
			try {
				alg = Alg.fromString(raw);
			} catch (e) {
				setMessage(`Could not parse “${raw}”: ${e.message}`, "error");
				return;
			}

			const moves = [...alg.experimentalLeafMoves()];
			if (moves.length === 0) {
				setMessage(`“${raw}” contains no moves.`, "error");
				return;
			}

			try {
				for (const move of moves) {
					player.experimentalAddMove(move);
				}
			} catch (e) {
				setMessage(`Could not apply “${raw}”: ${e.message}`, "error");
				return;
			}

			moveCount += moves.length;
			const plural = moves.length === 1 ? "" : "s";
			setMessage(
				`Applied ${moves.length} move${plural} (${raw}). Total moves applied: ${moveCount}.`,
			);
		}

		function resetCube() {
			const raw = resetInput.value.trim();
			let resetAlg;
			if (raw) {
				try {
					resetAlg = Alg.fromString(raw);
				} catch (e) {
					setMessage(
						`Could not parse reset mutation “${raw}”: ${e.message}`,
						"error",
					);
					return;
				}
			} else {
				resetAlg = new Alg();
			}

			// Clear any moves applied with Run, then set the cube to the
			// "reset state": the solved cube, then the reset mutation.
			player.alg = new Alg();
			player.experimentalSetupAlg = resetAlg;
			// Show the end of the timeline, i.e. the state after the reset
			// mutation (instead of the solved start).
			player.timestamp = "end";
			moveCount = 0;
			setMessage(raw ? `Reset to solved + “${raw}”.` : "Reset to solved.");
		}

		form.addEventListener("submit", (e) => {
			e.preventDefault();
			runMutation();
		});

		resetForm.addEventListener("submit", (e) => {
			e.preventDefault();
			resetCube();
		});

		// Toggle between the full view and the CFOP cross-only stickering.
		let crossOnly = false;
		crossToggleBtn.addEventListener("click", () => {
			crossOnly = !crossOnly;
			player.experimentalStickering = crossOnly ? "Cross" : null;
			crossToggleBtn.setAttribute("aria-pressed", String(crossOnly));
			setMessage(
				crossOnly
					? "Cross-only view enabled (CFOP cross pieces highlighted)."
					: "Full view restored.",
			);
		});

		// Animation speed. The slider maps directly to cubing.js's `tempoScale`
		// (1 = normal speed). Default to 0.25 — a lot slower than the default.
		function updateSpeed() {
			const scale = Number(speedSlider.value);
			player.tempoScale = scale;
			speedValue.textContent = `${scale.toFixed(2)}×`;
		}
		speedSlider.addEventListener("input", updateSpeed);
		updateSpeed();

		// Follow the site's light/dark theme (toggled in the header).
		function currentTheme() {
			const explicit = document.documentElement.style.colorScheme;
			if (explicit === "dark" || explicit === "light") return explicit;
			return window.matchMedia("(prefers-color-scheme: dark)").matches
				? "dark"
				: "light";
		}
		player.colorScheme = currentTheme();
		new MutationObserver(() => {
			player.colorScheme = currentTheme();
		}).observe(document.documentElement, {
			attributes: true,
			attributeFilter: ["style"],
		});
	}
</script>

<style>
	.cube-explorer {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.player-container {
		border-radius: 12px;
		overflow: hidden;
		border: 1px solid
			light-dark(rgba(15, 18, 25, 0.12), rgba(255, 255, 255, 0.14));
		background: light-dark(#ffffff, #202020);
	}

	#player-host {
		width: 100%;
		height: 420px;
	}

	#player-host :global(twisty-player) {
		width: 100%;
		height: 100%;
		--twisty-player-background: transparent;
	}

	.controls {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.view-controls {
		align-items: center;
		justify-content: space-between;
	}

	.speed-control {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.9em;
		color: rgb(var(--gray));
	}

	.speed-control input[type="range"] {
		width: 9rem;
		accent-color: var(--accent);
	}

	.speed-value {
		min-width: 3.2em;
		font-variant-numeric: tabular-nums;
		color: var(--font-secondary);
	}

	#mutation-input,
	#reset-input {
		flex: 1 1 15rem;
		font-family: "Atkinson", ui-monospace, SFMono-Regular, Menlo, Consolas,
			monospace;
		font-size: 1rem;
		padding: 0.55rem 0.75rem;
		border-radius: 8px;
		border: 1px solid
			light-dark(rgba(15, 18, 25, 0.15), rgba(255, 255, 255, 0.2));
		background: light-dark(#ffffff, #1a1a1a);
		color: var(--font-secondary);
	}

	#mutation-input:focus-visible,
	#reset-input:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 1px;
		border-color: transparent;
	}

	.btn {
		font-family: inherit;
		font-size: 1rem;
		padding: 0.55rem 1.25rem;
		border-radius: 8px;
		cursor: pointer;
		border: 1px solid
			light-dark(rgba(15, 18, 25, 0.15), rgba(255, 255, 255, 0.2));
		background: transparent;
		color: var(--font-secondary);
		transition: background-color 0.15s ease, color 0.15s ease,
			border-color 0.15s ease;
	}

	.btn:hover {
		border-color: var(--accent);
		color: var(--accent);
	}

	.btn:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 1px;
	}

	.btn.primary {
		background: var(--accent);
		border-color: var(--accent);
		color: #ffffff;
	}

	.btn.primary:hover {
		background: var(--accent-dark);
		color: #ffffff;
	}

	.btn.toggle[aria-pressed="true"] {
		background: var(--accent);
		border-color: var(--accent);
		color: #ffffff;
	}

	.btn.toggle[aria-pressed="true"]::before {
		content: "✓ ";
	}

	.message {
		min-height: 1.7em;
		margin: 0;
		color: rgb(var(--gray));
	}

	.message[data-kind="error"] {
		color: light-dark(#c62828, #ff8a80);
	}

	.hint {
		margin: 0;
		font-size: 0.9em;
		color: rgb(var(--gray));
	}

	@media (max-width: 720px) {
		#player-host {
			height: 320px;
		}
	}
</style>
