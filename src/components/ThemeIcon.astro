<button id="themeToggle" aria-label="Toggle theme">
  <svg aria-hidden="true" width="30px" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
    <path class="sun" fill-rule="evenodd" d="M12 17.5a5.5 5.5 0 1 0 0-11 5.5 5.5 0 0 0 0 11zm0 1.5a7 7 0 1 0 0-14 7 7 0 0 0 0 14zm12-7a.8.8 0 0 1-.8.8h-2.4a.8.8 0 0 1 0-1.6h2.4a.8.8 0 0 1 .8.8zM4 12a.8.8 0 0 1-.8.8H.8a.8.8 0 0 1 0-1.6h2.5a.8.8 0 0 1 .8.8zm16.5-8.5a.8.8 0 0 1 0 1l-1.8 1.8a.8.8 0 0 1-1-1l1.7-1.8a.8.8 0 0 1 1 0zM6.3 17.7a.8.8 0 0 1 0 1l-1.7 1.8a.8.8 0 1 1-1-1l1.7-1.8a.8.8 0 0 1 1 0zM12 0a.8.8 0 0 1 .8.8v2.5a.8.8 0 0 1-1.6 0V.8A.8.8 0 0 1 12 0zm0 20a.8.8 0 0 1 .8.8v2.4a.8.8 0 0 1-1.6 0v-2.4a.8.8 0 0 1 .8-.8zM3.5 3.5a.8.8 0 0 1 1 0l1.8 1.8a.8.8 0 1 1-1 1L3.5 4.6a.8.8 0 0 1 0-1zm14.2 14.2a.8.8 0 0 1 1 0l1.8 1.7a.8.8 0 0 1-1 1l-1.8-1.7a.8.8 0 0 1 0-1z"/>
    <path class="moon" fill-rule="evenodd" d="M16.5 6A10.5 10.5 0 0 1 4.7 16.4 8.5 8.5 0 1 0 16.4 4.7l.1 1.3zm-1.7-2a9 9 0 0 1 .2 2 9 9 0 0 1-11 8.8 9.4 9.4 0 0 1-.8-.3c-.4 0-.8.3-.7.7a10 10 0 0 0 .3.8 10 10 0 0 0 9.2 6 10 10 0 0 0 4-19.2 9.7 9.7 0 0 0-.9-.3c-.3-.1-.7.3-.6.7a9 9 0 0 1 .3.8z"/>
  </svg>
</button>

<style>
  :root {
    /* WICHTIG: Dem Browser sagen, dass die Seite beide unterstützt */
    color-scheme: light dark;
  }

  #themeToggle {
    border: 0;
    background: none;
    cursor: pointer;
    /* Nutzt die Standard-Textfarbe des jeweiligen Modus */
    fill: light-dark(#000, #fff);
  }
</style>


<script is:inline>
  const root = document.documentElement;
  const btn = document.getElementById("themeToggle");
  const sunIcon = btn?.querySelector(".sun");
  const moonIcon = btn?.querySelector(".moon");

  const updateUI = (theme) => {
    // 1. color-scheme am Root setzen (für Browser-Elemente)
    root.style.colorScheme = theme;
    localStorage.setItem('theme', theme);

    // 2. SVG Pfade direkt manipulieren
    if (theme === 'dark') {
      btn.style.fill = 'white';
      sunIcon.style.display = 'none';
      moonIcon.style.display = 'block';
    } else {
      btn.style.fill = 'black';
      sunIcon.style.display = 'block';
      moonIcon.style.display = 'none';
    }
  };

  // Initialisierung: Wert abfragen (entweder bereits gesetzt oder System-Standard)
  const getInitialTheme = () => {
    // Falls du color-scheme schon irgendwo im HTML/CSS gesetzt hast:
    const savedStatus = root.style.colorScheme;
    if (savedStatus) return savedStatus;

    // Sonst System-Präferenz prüfen
    return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  };

  // Beim Laden ausführen
  updateUI(getInitialTheme());
  

  // Klick-Event
  btn?.addEventListener("click", () => {
    const nextTheme = root.style.colorScheme === 'dark' ? 'light' : 'dark';
    updateUI(nextTheme);
  });


  //const handleToggleClick = () => {
  //  if (root.style.colorScheme === 'dark') {
  //    root.style.colorScheme = 'light';
  //  } else {
  //    root.style.colorScheme = 'dark';
  //  }
  //}
  //document.getElementById("themeToggle")?.addEventListener("click", handleToggleClick);
</script>
