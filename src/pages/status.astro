---
import Layout from "../layouts/DefaultPage.astro";

import { getCalendarData } from "../lib/fetchCalendarData";
const data = await getCalendarData();
---

<Layout>
  <h1>Status</h1>
  {
    data ? (
      <p>Meine momentane Kapazität ist {data.capacity}%</p>
    ) : (
      <p>Keine Angaben verfügbar</p>
    )
  }
</Layout>
